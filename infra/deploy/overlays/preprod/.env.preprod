# =============================================================================
# Pre-production Environment Configuration
# =============================================================================
# Non-secret config lives here (committed).
# Secrets are provided via .env.secrets (gitignored), merged at deploy time.
# Kept off real participants: e-mails to the console, HelloAsso sandbox,
# no organizer e-mails.
# =============================================================================

# Docker
DOCKER_NETWORK=jib-network
DOCKER_REGISTRY_REPOSITORY=ghcr.io/kosmio/

# Traefik
TRAEFIK_VERSION=v3.7.16
ACME_EMAIL=mathieu+xylo@kosm.io

# Hostname (single domain, Strapi served under /strapi path)
HOST_NAME=jib.kosmio.dev

# Versions
JIB_VERSION=0.1.0

# PostgreSQL
POSTGRES_HOSTNAME=jib-postgres
POSTGRES_USER=strapi
POSTGRES_PASSWORD=changeme
POSTGRES_DB=strapi

# Strapi
STRAPI_BASE_URL=https://jib.kosmio.dev
STRAPI_ADMIN_URL=/admin
STRAPI_APP_KEYS=changeme
STRAPI_API_TOKEN_SALT=changeme
STRAPI_ADMIN_JWT_SECRET=changeme
STRAPI_JWT_SECRET=changeme

# Strapi URLs
STRAPI_INTERNAL_URL=http://jib-strapi:1337
STRAPI_PUBLIC_URL=https://jib.kosmio.dev/strapi

# Email provider: console only, preprod holds a copy of prod participants
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_LIST_ID=
EMAIL_CONTACT_TO=mathieu+xylo@kosm.io
EMAIL_CONTACT_TEMPLATE_ID=

# Participant space
PUBLIC_URL=https://jib.kosmio.dev
CORS_ORIGINS=https://jib.kosmio.dev
# E-mails of the organizers, separated by commas
ORGANIZER_EMAILS=
IS_PROXIED=true
CRON_ENABLED=true

# HelloAsso (the client secret comes from .env.secrets)
HELLOASSO_API_BASE=https://api.helloasso-sandbox.com/v5
HELLOASSO_CLIENT_ID=

# Captcha (Altcha)
ALTCHA_HMAC_KEY=changeme

# Analytics (Matomo)
PUBLIC_MATOMO_URL=
PUBLIC_MATOMO_SITE_ID=
