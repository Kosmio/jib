---
// Icônes en trait (stroke 2 px) en SVG en ligne, décoratives : le sens est toujours porté par le texte voisin (07-design.md).
export interface Props {
  name: "alert" | "check" | "info";
}

const { name } = Astro.props;
---

<svg
  aria-hidden="true"
  class="size-5 shrink-0"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <circle cx="12" cy="12" r="9"></circle>
  {name === "alert" && <path d="M12 8v5M12 16.5h.01" />}
  {name === "check" && <path d="m8.5 12.5 2.5 2.5 4.5-5" />}
  {name === "info" && <path d="M12 11v5M12 7.5h.01" />}
</svg>
