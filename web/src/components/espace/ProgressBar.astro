---
// Barre de progression (E1 « Votre profil ») : piste `surface-alt`, remplissage vert Xylofutur (jamais en texte).
// Le pourcentage est aussi écrit à côté par la page ; la barre porte son nom et sa valeur pour les lecteurs d'écran.
export interface Props {
  /** 0 à 100. */
  value: number;
  label: string;
}

const { value, label } = Astro.props;
const percent = Math.max(0, Math.min(100, Math.round(value)));
---

<div
  role="progressbar"
  aria-label={label}
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow={percent}
  class="h-3 w-full overflow-hidden rounded-full bg-surface-alt"
>
  <div class="h-full rounded-full bg-primary" style={`width: ${percent}%`}></div>
</div>
