---
// Page d'aide de l'interface organisation (15-administration.md, F-187) : sections ancrées, sommaire de la page, impression propre,
// page précédente et suivante. Les liens « ? » des écrans y mènent (F-189).
import OrganizerFrame from "../../../../../components/espace/OrganizerFrame.astro";
import { helpPage, helpPages } from "../../../../../lib/espace/help";
import { organizerPage } from "../../../../../lib/espace/organizer";

const page = await organizerPage(Astro, "aide");
if (page.kind === "response") return page.response;
const { edition, me, slug, base } = page;
const help = helpPage(Astro.params.page ?? "");
if (!help) return Astro.rewrite("/espace/introuvable");
const index = helpPages.indexOf(help);
const previous = helpPages[index - 1];
const next = helpPages[index + 1];
---

<OrganizerFrame title={`Aide : ${help.title}`} heading={help.title} tab="aide" edition={edition} me={me} slug={slug} base={base} refused={page.kind === "refused"}>
  <div class="help-article grid items-start gap-8 lg:grid-cols-[14rem_1fr]">
    <nav aria-label="Dans cette page" class="print:hidden lg:sticky lg:top-4">
      <a href={`${base}/organisateur/aide`} class="font-semibold text-title underline-offset-4 hover:underline">Toute l’aide</a>
      {
        help.sections.length > 0 && (
          <ol class="mt-3 space-y-1.5 border-l-2 border-surface-alt pl-3 text-sm">
            {help.sections.map((section) => (
              <li>
                <a href={`#${section.id}`} class="text-muted hover:text-title hover:underline">
                  {section.title}
                </a>
              </li>
            ))}
          </ol>
        )
      }
      <button type="button" class="mt-4 inline-flex min-h-11 items-center rounded-lg border-2 border-title bg-white px-4 text-sm font-bold text-title hover:bg-surface" data-imprimer>Imprimer</button>
    </nav>
    <article class="help-text max-w-[70ch] rounded-xl border border-surface-alt bg-white p-6 md:p-8" set:html={help.html} />
  </div>
  <nav aria-label="Pages d’aide voisines" class="mt-8 flex flex-wrap justify-between gap-4 print:hidden">
    {previous ? <a href={`${base}/organisateur/aide/${previous.slug}`} class="font-semibold text-title underline-offset-4 hover:underline">Précédent : {previous.title}</a> : <span />}
    {next && <a href={`${base}/organisateur/aide/${next.slug}`} class="font-semibold text-title underline-offset-4 hover:underline">Suivant : {next.title}</a>}
  </nav>
  <script>
    document.querySelector("[data-imprimer]")?.addEventListener("click", () => window.print());
  </script>
</OrganizerFrame>
