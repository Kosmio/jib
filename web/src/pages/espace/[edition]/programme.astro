---
// E8, programme (F-80, F-81, NF-31) : public, rendu par le serveur, sans JavaScript. Trois onglets, Journée, Intervenants et Infos pratiques,
// faits d'ancres : le panneau ciblé par l'adresse (`#intervenants`) s'affiche, Journée sans ancre. La barre d'onglets de l'espace
// n'apparaît qu'avec une session valable pour l'édition ; sans session, « Prendre RDV » mène à E0. Contenus lus dans Strapi, sans copie.
import { marked } from "marked";
import { safeHtml } from "../../../lib/html";
import AppShell from "../../../components/espace/AppShell.astro";
import EmptyState from "../../../components/espace/EmptyState.astro";
import Notice from "../../../components/espace/Notice.astro";
import { Avatar } from "../../../react-components/espace/ProfileCardView";
import { espaceGet, getMe, getOpenEdition, publicStrapiUrl } from "../../../lib/espace/api";
import type { ProfileCard } from "../../../lib/espace/client";
import { editionLine } from "../../../lib/espace/format";
import { requestWindow } from "../../../lib/espace/meetings";
import ProgramNow from "../../../react-components/espace/ProgramNow";
import { getProgramTheme } from "../../../lib/program-themes";

// Forme de `GET /editions/:slug/program` (phase-2-plan.md, section 3.2). Les horaires sont du texte (« 9h15 ») ; `startsAt` est l'instant ISO.
type Speaker = { name: string; title: string | null; organisation: string | null; photoUrl: string | null; attendeeId: string | null };
type Session = {
  id: string;
  title: string;
  description: string | null;
  start: string | null;
  end: string | null;
  startsAt: string | null;
  kind: "talk" | "b2b_break" | "other";
  until?: string | null;
  state?: "current" | "next" | null;
  meetings?: { id: string; start: string; counterpart: string; location: string | null }[];
  theme?: string | null;
  subtitle?: string | null;
  speakers: Speaker[];
};
type Program = {
  now?: string;
  liveDay?: boolean;
  flyer?: { imageUrl: string | null; pdfUrl: string | null };
  notes: string[];
  sessions: Session[];
  speakers: (Speaker & { sessions: string[] })[];
  venues: { name: string; address: string | null; mapUrl: string | null; timeSlot: string | null }[];
};

const slug = Astro.params.edition ?? "";
const edition = await getOpenEdition(slug);
if (!edition) return Astro.rewrite("/espace/introuvable");

const cookie = Astro.request.headers.get("cookie");
const me = await getMe(cookie);
const shellMe = me?.edition.slug === slug ? me : null;
const base = `/espace/${encodeURIComponent(slug)}`;

// Public, mais le cookie est relayé : `attendeeId` (lien vers la fiche) n'est renseigné que pour une session qui peut ouvrir cette fiche (A-34).
// `?now=` simule l'heure en préproduction et en test (F-150) ; Strapi l'ignore en production.
const simulatedNow = Astro.url.searchParams.get("now");
const result = await espaceGet<Program>(`/editions/${encodeURIComponent(slug)}/program${simulatedNow ? `?now=${encodeURIComponent(simulatedNow)}` : ""}`, cookie);
if (!result.ok && result.status === 404) return Astro.rewrite("/espace/introuvable");
const program: Program = result.ok
  ? { notes: [], sessions: [], speakers: [], venues: [], ...result.data }
  : { notes: [], sessions: [], speakers: [], venues: [] };

// F-80 : la séquence sans horaire « (les horaires sont indiqués à titre provisoire) » devient la mention en tête de journée.
const notes = program.notes
  .map((note) => note.trim().replace(/^\((.*)\)$/s, "$1").trim())
  .filter(Boolean)
  .map((note) => note.charAt(0).toUpperCase() + note.slice(1));

// Programme imprimé : l'image ouvre le PDF. Les médias sont servis par Strapi, adresse publique.
const mediaUrl = (url: string | null | undefined) =>
  url ? (/^https?:\/\//i.test(url) ? url : url.startsWith("/") ? `${publicStrapiUrl}${url}` : null) : null;
const flyerImage = mediaUrl(program.flyer?.imageUrl);
const flyerPdf = mediaUrl(program.flyer?.pdfUrl);

// F-152 : « Prendre RDV » seulement fenêtre de demandes ouverte ; sinon la pause dit combien de rendez-vous j'y ai.
const now = program.now ? new Date(program.now) : new Date();
const windowOpen = requestWindow(edition, now).state === "open";
const liveDay = Boolean(program.liveDay);
const liveSessions = program.sessions.flatMap(({ id, startsAt, until }) => (startsAt && until ? [{ id, startsAt, until }] : []));
const STATE_BADGE =
  "inline-flex min-h-6 items-center rounded-full px-2.5 py-0.5 text-sm font-bold data-[state=current]:bg-title data-[state=current]:text-white data-[state=next]:border data-[state=next]:border-title data-[state=next]:bg-white data-[state=next]:text-title";
const STATE_LABEL = { current: "En cours", next: "À suivre" } as const;
const LIVE_ITEM = "scroll-mt-16 data-[state=current]:ring-2 data-[state=current]:ring-title data-[state=next]:ring-1 data-[state=next]:ring-title";
const meetingCount = (n: number) => (n === 0 ? "Aucun rendez-vous" : n === 1 ? "1 rendez-vous" : `${n} rendez-vous`);
const rdvHref = shellMe ? `${base}/annuaire` : `${base}/connexion`;
const profileHref = (attendeeId: string | null) => (shellMe && attendeeId ? `${base}/annuaire/p/${encodeURIComponent(attendeeId)}` : null);
const timeOf = ({ start, end }: Session) => start ?? (end ? `Fin ${end}` : "");
const html = (markdown: string | null) => (markdown ? safeHtml(marked.parse(markdown, { async: false }) as string) : "");
const webUrl = (url: string | null) => (url && /^https?:\/\//i.test(url) ? url : null);

function initialsOfName(name: string): string {
  const words = name.trim().split(/\s+/).filter(Boolean);
  return (words.length > 1 ? `${words[0][0]}${words.at(-1)![0]}` : (words[0] ?? "").slice(0, 2)).toUpperCase();
}
const speakerCard = (speaker: Speaker): ProfileCard => ({
  kind: "attendee",
  id: speaker.attendeeId ?? speaker.name,
  displayName: speaker.name,
  subtitle: "",
  photoUrl: speaker.photoUrl,
  initials: initialsOfName(speaker.name),
  tag: "speaker",
  topics: [],
});

// Onglets sans JavaScript : `:target` montre le panneau ciblé, `:has` retire Journée dès qu'un autre panneau est ciblé et
// colore l'onglet actif. Sans `:has` (navigateur ancien), Journée reste affichée sous le panneau ciblé.
const TAB = "flex min-h-11 items-center justify-center rounded-lg px-1 text-center font-heading font-semibold";
const tabClasses = {
  journee: `${TAB} bg-title text-white group-has-[#intervenants:target]/prog:bg-transparent group-has-[#intervenants:target]/prog:text-title group-has-[#infos:target]/prog:bg-transparent group-has-[#infos:target]/prog:text-title`,
  intervenants: `${TAB} text-title group-has-[#intervenants:target]/prog:bg-title group-has-[#intervenants:target]/prog:text-white`,
  infos: `${TAB} text-title group-has-[#infos:target]/prog:bg-title group-has-[#infos:target]/prog:text-white`,
};
const CARD = "rounded-xl border border-surface-alt bg-white p-4";
---

<AppShell title="Programme" active="program" editionSlug={slug} me={shellMe} eventDate={edition?.date ?? null}>
  <div class="group/prog">
    <header class="mx-auto max-w-180 px-4 pt-8 pb-4">
      {
        !shellMe && (
          <div class="mb-6 flex items-center justify-between gap-4">
            <img
              src="/assets/logo-jib.svg"
              alt="La Journée de l’Innovation de la Filière Bois"
              width="649"
              height="160"
              class="h-10 w-auto"
            />
            <a href={`${base}/connexion`} class="inline-flex min-h-11 items-center font-semibold text-title underline">
              Accéder à mon espace
            </a>
          </div>
        )
      }
      <h1 class="text-2xl md:text-3xl">Programme</h1>
      <p class="mt-2 text-muted">{editionLine(edition)}</p>
    </header>

    <nav aria-label="Sections du programme" class="sticky top-0 z-20 border-b border-surface-alt bg-white">
      <ul class="mx-auto grid max-w-180 grid-cols-[4fr_5fr_6fr] gap-1 px-4 py-2 sm:grid-cols-3">
        <li><a href="#journee" class={tabClasses.journee} aria-current="page">Journée</a></li>
        <li><a href="#intervenants" class={tabClasses.intervenants}>Intervenants</a></li>
        <li><a href="#infos" class={tabClasses.infos}>Infos pratiques</a></li>
      </ul>
    </nav>

    <div class="mx-auto max-w-180 px-4 pt-6">
      {!result.ok && <Notice kind="alert">Le programme n’est pas disponible pour le moment. Réessayez dans quelques instants.</Notice>}

      <section
        id="journee"
        aria-labelledby="journee-titre"
        class="group-has-[#intervenants:target]/prog:hidden group-has-[#infos:target]/prog:hidden"
      >
        <h2 id="journee-titre" class="sr-only">Journée</h2>
        {
          (flyerImage || flyerPdf) && (
            <a
              href={flyerPdf ?? flyerImage}
              target="_blank"
              rel="noopener noreferrer"
              class={`${CARD} mb-4 flex min-h-11 items-center gap-4 font-semibold text-title hover:bg-surface`}
            >
              {flyerImage && <img src={flyerImage} alt="" loading="lazy" class="w-20 shrink-0 rounded-md border border-surface-alt" />}
              <span class="underline">
                {flyerPdf ? "Ouvrir le programme imprimable (PDF)" : "Agrandir le programme"}
                <span class="sr-only"> (s’ouvre dans un nouvel onglet)</span>
              </span>
            </a>
          )
        }
        {notes.map((note) => <p class="mb-3 text-muted">{note}</p>)}
        {
          liveDay && liveSessions.length > 0 && (
            <p class="mb-3" data-jump-now hidden={!program.sessions.some(({ state }) => state === "current")}>
              <a href="#en-cours" class="inline-flex min-h-11 items-center font-semibold text-title underline">Aller à la séquence en cours</a>
            </p>
          )
        }
        {
          !shellMe && windowOpen && program.sessions.some(({ kind }) => kind === "b2b_break") && (
            <p class="mb-3 text-muted">Pour prendre rendez-vous, connectez-vous avec l’adresse de votre inscription.</p>
          )
        }
        {
          !result.ok ? null : program.sessions.length === 0 ? (
            <EmptyState title="Le programme sera publié bientôt" />
          ) : (
            <ol class="space-y-3">
              {program.sessions.map((session) => {
                const isBreak = session.kind === "b2b_break";
                const description = html(session.description);
                const theme = isBreak ? null : getProgramTheme(session.theme, session.title);
                const state = liveDay ? (session.state ?? null) : null;
                const badge = liveDay && (
                  <span data-state-badge data-state={state ?? undefined} hidden={!state} class={STATE_BADGE}>{state ? STATE_LABEL[state] : ""}</span>
                );
                const mine = session.meetings ?? [];
                const myMeetings = isBreak && mine.length > 0 && (
                  <ul class="mt-2 space-y-1" aria-label="Mes rendez-vous" data-my-meetings>
                    {mine.map((meeting) => (
                      <li class="text-sm font-semibold text-ink">
                        {meeting.start}
                        {` · ${meeting.counterpart}`}
                        {meeting.location && ` · ${meeting.location}`}
                      </li>
                    ))}
                  </ul>
                );
                const time = session.startsAt ? <time datetime={session.startsAt}>{timeOf(session)}</time> : timeOf(session);
                const speakers = session.speakers?.length > 0 && (
                  <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm text-muted">
                    {session.speakers.map((speaker) => {
                      const href = profileHref(speaker.attendeeId);
                      const label = speaker.organisation ? `${speaker.name}, ${speaker.organisation}` : speaker.name;
                      return <li>{href ? <a href={href} class="inline-flex min-h-11 items-center text-title underline">{label}</a> : label}</li>;
                    })}
                  </ul>
                );
                if (theme) {
                  return (
                    <li
                      data-session-id={session.id}
                      data-state={state ?? undefined}
                      id={state === "current" ? "en-cours" : undefined}
                      class={`overflow-hidden rounded-xl border-2 bg-white ${LIVE_ITEM} ${theme.border}`}
                    >
                      <div class={`flex items-center gap-3 p-4 ${theme.band}`}>
                        <span aria-hidden="true" class={`flex size-11 shrink-0 items-center justify-center rounded-full ${theme.badge}`}>
                          <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            {theme.icon.map((d) => <path d={d} />)}
                            {theme.circles?.map(([cx, cy, r]) => <circle cx={cx} cy={cy} r={r} />)}
                          </svg>
                        </span>
                        <div class="min-w-0 flex-1">
                          <p class="font-heading text-lg font-medium">
                            {time}
                            {session.end && <Fragment set:text={`à\u00a0${session.end}`} />}
                          </p>
                          {session.subtitle && <p class="leading-snug">{session.subtitle}</p>}
                          {badge && <p class="mb-1">{badge}</p>}
                          <h3 class="text-lg leading-snug font-bold text-inherit uppercase">{session.title}</h3>
                        </div>
                      </div>
                      {(description || speakers) && (
                        <div class="p-4">
                          {description && (
                            <div class="text-muted italic [&_a]:text-title [&_a]:underline [&_p+p]:mt-2 [&_ul]:list-disc [&_ul]:pl-5" set:html={description} />
                          )}
                          {speakers}
                        </div>
                      )}
                    </li>
                  );
                }
                return (
                  <li
                    data-session-id={session.id}
                    data-state={state ?? undefined}
                    id={state === "current" ? "en-cours" : undefined}
                    class={`flex gap-4 rounded-xl border p-4 ${LIVE_ITEM} ${isBreak ? "items-center border-gold/50 bg-gold/15" : "border-surface-alt bg-white"}`}
                  >
                    <p class={`w-14 shrink-0 font-heading text-lg font-medium ${isBreak ? "text-gold-ink" : "text-title"}`}>{time}</p>
                    <div class="min-w-0 flex-1">
                      {badge && <p class="mb-1">{badge}</p>}
                      <h3 class={`text-lg leading-snug font-bold ${isBreak ? "text-gold-ink" : "text-ink"}`}>{session.title}</h3>
                      {description && (
                        <div
                          class="mt-1 text-muted [&_a]:text-title [&_a]:underline [&_p+p]:mt-2 [&_ul]:list-disc [&_ul]:pl-5"
                          set:html={description}
                        />
                      )}
                      {speakers}
                      {myMeetings}
                    </div>
                    {isBreak && !windowOpen && shellMe && (
                      <p class="shrink-0 text-right font-semibold text-gold-ink" data-meeting-count>{meetingCount(mine.length)}</p>
                    )}
                    {isBreak && windowOpen && (
                      <a
                        href={rdvHref}
                        class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-lg bg-gold px-4 font-bold text-gold-ink hover:bg-gold-light"
                      >
                        Prendre RDV
                        <span class="sr-only">{`\u00a0: ${session.title}`}</span>
                      </a>
                    )}
                  </li>
                );
              })}
            </ol>
          )
        }
      </section>

      <section id="intervenants" aria-labelledby="intervenants-titre" class="hidden target:block">
        <h2 id="intervenants-titre" class="sr-only">Intervenants</h2>
        {
          !result.ok ? null : program.speakers.length === 0 ? (
            <EmptyState title="Les intervenants seront annoncés bientôt" />
          ) : (
            <ul class="space-y-3">
              {program.speakers.map((speaker) => {
                const href = profileHref(speaker.attendeeId);
                const subtitle = [speaker.title, speaker.organisation].filter(Boolean).join(", ");
                const Tag = href ? "a" : "div";
                return (
                  <li>
                    <Tag href={href ?? undefined} class={`${CARD} flex items-center gap-4 ${href ? "min-h-11 hover:bg-surface" : ""}`}>
                      <Avatar card={speakerCard(speaker)} strapiUrl={publicStrapiUrl} />
                      <span class="min-w-0 flex-1">
                        <span class="block text-lg leading-snug font-bold text-ink">{speaker.name}</span>
                        {subtitle && <span class="block leading-snug text-muted">{subtitle}</span>}
                        {speaker.sessions?.length > 0 && (
                          <span class="mt-1 block text-sm text-muted">{`Intervient\u00a0: ${speaker.sessions.join(", ")}`}</span>
                        )}
                      </span>
                      {href && (
                        <span aria-hidden="true" class="flex size-11 shrink-0 items-center justify-center rounded-full bg-surface text-title">
                          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m9 6 6 6-6 6" />
                          </svg>
                        </span>
                      )}
                    </Tag>
                  </li>
                );
              })}
            </ul>
          )
        }
      </section>

      <section id="infos" aria-labelledby="infos-titre" class="hidden target:block">
        <h2 id="infos-titre" class="sr-only">Infos pratiques</h2>
        {
          !result.ok ? null : program.venues.length === 0 ? (
            <EmptyState title="Les informations pratiques seront publiées bientôt" />
          ) : (
            <ul class="space-y-3">
              {program.venues.map((venue) => {
                const map = webUrl(venue.mapUrl);
                return (
                  <li class={`${CARD} p-5`}>
                    <h3 class="font-heading text-lg font-semibold">{venue.name}</h3>
                    {venue.timeSlot && <p class="mt-1 text-muted">{venue.timeSlot}</p>}
                    {venue.address && <p class="mt-2 whitespace-pre-line">{venue.address}</p>}
                    {map && (
                      <a
                        href={map}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mt-3 inline-flex min-h-11 items-center font-semibold text-title underline"
                      >
                        Voir sur la carte
                        <span class="sr-only"> (s’ouvre dans un nouvel onglet)</span>
                      </a>
                    )}
                  </li>
                );
              })}
            </ul>
          )
        }
      </section>
    </div>
  </div>
  {liveDay && liveSessions.length > 0 && <ProgramNow client:load sessions={liveSessions} now={program.now ?? now.toISOString()} />}
</AppShell>

<script>
  // F-129 : l'onglet actif est exposé aux technologies d'assistance. Le rendu serveur marque Journée ; l'ancre de l'adresse décide ensuite.
  const tabs = document.querySelectorAll<HTMLAnchorElement>('nav[aria-label="Sections du programme"] a');
  const sync = () => {
    const hash = location.hash;
    const active = Array.from(tabs).find((tab) => tab.getAttribute("href") === hash && hash !== "#journee") ?? tabs[0];
    for (const tab of tabs) {
      if (tab === active) tab.setAttribute("aria-current", "page");
      else tab.removeAttribute("aria-current");
    }
  };
  // Les onglets ne remplissent pas l'historique : l'entrée courante est remplacée (sans JavaScript, l'ancre reste un lien ordinaire).
  for (const tab of tabs) {
    tab.addEventListener("click", (event) => {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      location.replace(tab.getAttribute("href") ?? "#journee");
    });
  }
  window.addEventListener("hashchange", sync);
  sync();
</script>
