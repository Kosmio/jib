---
// E6 : mon agenda (F-60 à F-66). Le rendu serveur lit `GET /meetings` ; l'îlot AgendaBoard accepte, refuse, contre-propose et annule,
// puis relit la liste. `?demande={id}` (lien des e-mails) met une demande en évidence ; l'acceptation reste un clic, jamais un GET (Q-13).
import AppShell from "../../../components/espace/AppShell.astro";
import AgendaBoard from "../../../react-components/espace/AgendaBoard";
import { Icon } from "../../../react-components/espace/MeetingStatus";
import { espaceGet, guardSession, publicStrapiUrl } from "../../../lib/espace/api";
import { bannerColor } from "../../../lib/espace/format";
import { calendarUrl, dayLabelOf, type MeetingsResponse } from "../../../lib/espace/meetings";

const slug = Astro.params.edition ?? "";
const cookie = Astro.request.headers.get("cookie");
const guard = await guardSession(slug, cookie);
if ("redirect" in guard) return Astro.redirect(guard.redirect);
if ("notFound" in guard) return Astro.rewrite("/espace/introuvable");
const { edition, me } = guard;

const meetings = await espaceGet<MeetingsResponse>("/meetings", cookie);
if (!meetings.ok && meetings.status === 401) return Astro.redirect(`/espace/${encodeURIComponent(slug)}/connexion`);
if (!meetings.ok) throw new Error(`GET /meetings : ${meetings.status}`);

const day = dayLabelOf(edition.date);
const dayLine = [day && day.charAt(0).toUpperCase() + day.slice(1), edition.city].filter(Boolean).join(", ");
const highlightId = Astro.url.searchParams.get("demande");
---

<AppShell title="Mon agenda" active="agenda" editionSlug={slug} me={me}>
  <header class="border-b border-surface-alt bg-white">
    <div class="mx-auto flex max-w-180 flex-wrap items-center justify-between gap-x-4 gap-y-3 px-4 py-5">
      <div class="min-w-0">
        <h1 class="text-2xl leading-tight md:text-3xl">Mon agenda</h1>
        {dayLine && <p class="mt-1 text-lg text-muted">{dayLine}</p>}
      </div>
      <a
        href={calendarUrl(publicStrapiUrl)}
        class="inline-flex min-h-11 items-center gap-2 rounded-lg border-2 border-title bg-white px-4 font-semibold text-title hover:bg-surface"
      >
        <Icon name="download" />
        Calendrier
        <span class="sr-only"> (fichier .ics des rendez-vous confirmés et des séquences)</span>
      </a>
    </div>
  </header>

  <div class="mx-auto max-w-180 px-4 pb-6">
    <noscript>
      <p class="mt-6 font-semibold">Cette page demande JavaScript pour répondre aux demandes. Activez-le ou utilisez un autre navigateur.</p>
    </noscript>
    <AgendaBoard
      client:load
      strapiUrl={publicStrapiUrl}
      editionSlug={slug}
      themeColor={bannerColor(edition.themeColor)}
      dayLabel={day}
      initial={meetings.data}
      highlightId={highlightId}
    />
  </div>
</AppShell>
