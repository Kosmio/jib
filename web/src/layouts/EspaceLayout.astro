---
// Gabarit de l'espace participant : ni Header, ni Footer, ni Matomo, ni bandeau de cookies, ni Google Fonts (NF-07, NF-23).
// Les en-têtes de sécurité viennent de src/middleware.ts.
// Avec `shell` (pages à onglets, voir AppShell.astro), la barre d'onglets entre par le slot `nav`, avant `<main>`, et le contenu
// laisse la place de la barre : en bas sur mobile, à gauche à partir de 1024 px.
import "../styles/espace.css";
import { bannerColor } from "../lib/espace/format";

export interface Props {
  /** État de la page : « Connexion », « Lien envoyé »… Le gabarit y ajoute le nom de l'espace. */
  title: string;
  shell?: boolean;
  /** F-130 : couleur de l'édition pour la barre du navigateur, si la page l'a déjà lue ; sinon le bleu des titres (aucune requête ajoutée). */
  themeColor?: string | null;
  /** NF-24 : date de l'événement (« 2026-12-03 »), pour l'expiration de la copie hors connexion ; sans elle, 14 jours. */
  eventDate?: string | null;
}

const { title, shell = false, themeColor = null, eventDate = null } = Astro.props;
// Application installable : le manifeste est celui de l'édition de l'URL (pas de manifeste sur /espace/verifier ni sur la page introuvable).
const edition = Astro.params.edition;
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/assets/favicon-192.png" />
    <meta name="theme-color" content={bannerColor(themeColor) ?? "#325062"} />
    {edition && <link rel="manifest" href={`/espace/${encodeURIComponent(edition)}/manifest.webmanifest`} />}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/source-sans-3-latin-wght-normal.woff2" crossorigin />
    {eventDate && <meta name="espace-date" content={eventDate} />}
    <title>{title} | Espace participant, Journées de l’Innovation Filière Bois</title>
  </head>
  <body class="bg-surface font-sans text-ink antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:font-semibold focus:text-title"
    >
      Aller au contenu
    </a>
    <p
      id="hors-ligne"
      role="status"
      hidden
      class="sticky top-0 z-40 bg-gold px-4 py-2 text-center font-semibold text-gold-ink"
    >
    </p>
    <slot name="nav" />
    <main id="main-content" class={`min-h-screen ${shell ? "pb-24 lg:pb-12 lg:pl-64" : "pb-12"}`}>
      <slot />
    </main>
    <script>
      // Service worker de /espace/ (public/espace/sw.js) : copie de l'accueil, de l'agenda, du programme et des messages (NF-24).
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/espace/sw.js", { scope: "/espace/" }).catch(() => {});
        });
      }

      // F-131 : le service worker pose `data-hors-ligne` (heure de la copie) sur une page servie depuis sa copie. Bandeau, et plus
      // aucune action qui écrit : boutons et champs de <main> désactivés, clics et envois bloqués.
      const copie = document.documentElement.dataset.horsLigne;
      if (copie) {
        const heure = new Intl.DateTimeFormat("fr-FR", { timeZone: "Europe/Paris", hour: "2-digit", minute: "2-digit", hourCycle: "h23" })
          .formatToParts(new Date(copie))
          .reduce((acc, part) => ({ ...acc, [part.type]: part.value }), {} as Record<string, string>);
        const bandeau = document.getElementById("hors-ligne");
        if (bandeau) {
          bandeau.textContent = `Hors connexion : contenu enregistré à ${heure.hour} h ${heure.minute}`;
          bandeau.hidden = false;
        }
        const main = document.getElementById("main-content");
        const bloquer = () =>
          main?.querySelectorAll<HTMLElement>("button, input, textarea, select").forEach((el) => el.setAttribute("disabled", ""));
        bloquer();
        if (main) new MutationObserver(bloquer).observe(main, { childList: true, subtree: true });
        document.addEventListener("submit", (e) => (e.preventDefault(), e.stopImmediatePropagation()), true);
        document.addEventListener(
          "click",
          (e) => {
            if ((e.target as Element).closest("#main-content button, #main-content input[type=submit]")) (e.preventDefault(), e.stopImmediatePropagation());
          },
          true,
        );
      }

      // NF-24 : la déconnexion vide les copies avant l'envoi. Sans JavaScript, le formulaire part tel quel.
      document.addEventListener("submit", (e) => {
        const form = e.target as HTMLFormElement;
        if (!form.hasAttribute("data-espace-deconnexion") || !("caches" in window)) return;
        e.preventDefault();
        const vider = caches
          .keys()
          .then((noms) => Promise.all(noms.filter((n) => n.startsWith("jib-espace-v2-ed-")).map((n) => caches.delete(n))));
        Promise.race([vider, new Promise((resolve) => setTimeout(resolve, 1500))])
          .catch(() => {})
          .then(() => form.submit());
      });
    </script>
  </body>
</html>
