---
// Gabarit de l'espace participant : ni Header, ni Footer, ni Matomo, ni bandeau de cookies, ni Google Fonts (NF-07, NF-23).
// Les en-têtes de sécurité viennent de src/middleware.ts.
// Avec `shell` (pages à onglets, voir AppShell.astro), la barre d'onglets entre par le slot `nav`, avant `<main>`, et le contenu
// laisse la place de la barre : en bas sur mobile, à gauche à partir de 1024 px.
import "../styles/espace.css";

export interface Props {
  /** État de la page : « Connexion », « Lien envoyé »… Le gabarit y ajoute le nom de l'espace. */
  title: string;
  shell?: boolean;
}

const { title, shell = false } = Astro.props;
// Application installable : le manifeste est celui de l'édition de l'URL (pas de manifeste sur /espace/verifier ni sur la page introuvable).
const edition = Astro.params.edition;
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/assets/favicon-192.png" />
    {edition && <link rel="manifest" href={`/espace/${encodeURIComponent(edition)}/manifest.webmanifest`} />}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/source-sans-3-latin-wght-normal.woff2" crossorigin />
    <title>{title} | Espace participant, Journées de l’Innovation Filière Bois</title>
  </head>
  <body class="bg-surface font-sans text-ink antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:font-semibold focus:text-title"
    >
      Aller au contenu
    </a>
    <slot name="nav" />
    <main id="main-content" class={`min-h-screen ${shell ? "pb-24 lg:pb-12 lg:pl-64" : "pb-12"}`}>
      <slot />
    </main>
    <script>
      // Service worker minimal de /espace/ (public/espace/sw.js) : ni pages ni API en cache, seulement une page hors connexion.
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/espace/sw.js", { scope: "/espace/" }).catch(() => {});
        });
      }
    </script>
  </body>
</html>
