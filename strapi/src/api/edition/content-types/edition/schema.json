{
  "kind": "collectionType",
  "collectionName": "editions",
  "info": {
    "singularName": "edition",
    "pluralName": "editions",
    "displayName": "Édition",
    "description": "Les éditions régionales des Journées de l'Innovation Filière Bois"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "year": {
      "type": "integer",
      "required": true
    },
    "region": {
      "type": "enumeration",
      "enum": [
        "normandie",
        "provence-alpes-cote-d-azur",
        "nouvelle-aquitaine",
        "auvergne-rhone-alpes",
        "ile-de-france",
        "bretagne",
        "occitanie",
        "grand-est",
        "hauts-de-france",
        "pays-de-la-loire",
        "bourgogne-franche-comte",
        "centre-val-de-loire",
        "corse"
      ],
      "required": true
    },
    "date": {
      "type": "date"
    },
    "city": {
      "type": "string",
      "required": true
    },
    "edition_status": {
      "type": "enumeration",
      "enum": ["a-venir", "inscriptions-ouvertes", "complet", "passee"],
      "default": "a-venir",
      "required": true
    },
    "participants_count": {
      "type": "integer",
      "min": 0
    },
    "description": {
      "type": "richtext"
    },
    "inscription_url": {
      "type": "string"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "hero_bg_color": {
      "type": "customField",
      "customField": "plugin::color-picker.color"
    },
    "lieux": {
      "type": "component",
      "component": "edition.lieu",
      "repeatable": true
    },
    "sequences": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::sequence.sequence",
      "mappedBy": "edition"
    },
    "partenaires": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::partenaire.partenaire",
      "inversedBy": "editions"
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "video_urls": {
      "type": "text"
    },
    "summary": {
      "type": "richtext"
    },
    "testimonials": {
      "type": "richtext"
    },
    "participantSpaceEnabled": {
      "type": "boolean",
      "default": false,
      "private": true
    },
    "helloassoOrgSlug": {
      "type": "string",
      "private": true
    },
    "helloassoFormType": {
      "type": "enumeration",
      "enum": ["Event", "Membership", "CrowdFunding", "Donation", "PaymentForm", "Checkout", "Shop"],
      "default": "Event",
      "private": true
    },
    "helloassoFormSlug": {
      "type": "string",
      "private": true
    },
    "helloassoFieldMap": {
      "type": "json",
      "private": true
    },
    "slotDurationMinutes": {
      "type": "integer",
      "default": 15,
      "min": 1,
      "private": true
    },
    "tablesCount": {
      "type": "integer",
      "default": 20,
      "min": 0,
      "private": true
    },
    "meetingRequestsOpenAt": {
      "type": "datetime",
      "private": true
    },
    "meetingRequestsCloseAt": {
      "type": "datetime",
      "private": true
    }
  }
}
