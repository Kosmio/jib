HOST=0.0.0.0
PORT=1337
BASE_URL=http://localhost:1337

APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=your-api-token-salt
ADMIN_JWT_SECRET=your-admin-jwt-secret
TRANSFER_TOKEN_SALT=your-transfer-token-salt
JWT_SECRET=your-jwt-secret

# Database
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi

# Email provider (Brevo)
EMAIL_API_KEY=your-brevo-api-key
EMAIL_LIST_ID=1
EMAIL_CONTACT_TO=mathieu+xylo@kosm.io
EMAIL_CONTACT_TEMPLATE_ID=1

# Participant space e-mails: "console" writes to EMAIL_OUTBOX_FILE and sends nothing, "brevo" sends for real.
# Without EMAIL_PROVIDER: brevo when NODE_ENV=production, console otherwise.
EMAIL_PROVIDER=console
EMAIL_FROM="Journées de l’Innovation Filière Bois <espace@example.org>"
EMAIL_OUTBOX_FILE=.tmp/mail-outbox.jsonl

# Set to false to skip the demo editions on an empty database
# DEMO_SEED=false

# Captcha (Altcha, self-hosted), leave empty to disable
ALTCHA_HMAC_KEY=change-me-to-a-random-secret
