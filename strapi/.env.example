HOST=0.0.0.0
PORT=1337
BASE_URL=http://localhost:1337

APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=your-api-token-salt
ADMIN_JWT_SECRET=your-admin-jwt-secret
TRANSFER_TOKEN_SALT=your-transfer-token-salt
JWT_SECRET=your-jwt-secret

# Database
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi

# Email provider (Brevo)
EMAIL_API_KEY=your-brevo-api-key
EMAIL_LIST_ID=1
EMAIL_CONTACT_TO=mathieu+xylo@kosm.io
EMAIL_CONTACT_TEMPLATE_ID=1

# Participant space e-mails: "console" writes to EMAIL_OUTBOX_FILE and sends nothing, "brevo" sends for real.
# Without EMAIL_PROVIDER: brevo when NODE_ENV=production, console otherwise.
EMAIL_PROVIDER=console
EMAIL_FROM="Journées de l’Innovation Filière Bois <espace@example.org>"
EMAIL_OUTBOX_FILE=.tmp/mail-outbox.jsonl

# Participant space
# Public URL of the site: links of the e-mails and redirections
PUBLIC_URL=http://localhost:4321
# E-mails of the organizers, separated by commas: they sign in without a HelloAsso registration
ORGANIZER_EMAILS=organisation@example.org
# Origins allowed by CORS and by the Origin check of the writes, separated by commas
CORS_ORIGINS=http://localhost:4321
# true behind a reverse proxy (dev and prod servers): the client IP is read from X-Forwarded-For
IS_PROXIED=false
# Scheduled tasks (HelloAsso synchronisation, purge of expired tokens): true on the dev and prod servers
CRON_ENABLED=false

# HelloAsso (local: the fake, `pnpm helloasso:fake`; sandbox: https://api.helloasso-sandbox.com/v5)
HELLOASSO_API_BASE=http://localhost:4010/v5
HELLOASSO_CLIENT_ID=fake-client-id
HELLOASSO_CLIENT_SECRET=fake-client-secret

# Set to false to skip the demo editions on an empty database
# DEMO_SEED=false

# Captcha (Altcha, self-hosted), leave empty to disable
ALTCHA_HMAC_KEY=change-me-to-a-random-secret
