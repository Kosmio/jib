      "sequences": "relation",
      "partenaires": "relation",
      "gallery": "media",
      "video_urls": "text",
      "summary": "richtext",
      "testimonials": "richtext"
    },
    "structural": {
      "image": {
        "type": "media",
        "multiple": false,
        "allowedTypes": [
          "images"
        ]
      },
      "lieux": {
        "type": "component",
        "component": "edition.lieu",
        "repeatable": true
      },
      "sequences": {
        "type": "relation",
        "relation": "oneToMany",
        "target": "api::sequence.sequence",
        "mappedBy": "edition"
      },
      "partenaires": {
        "type": "relation",
        "relation": "manyToMany",
        "target": "api::partenaire.partenaire",
        "inversedBy": "editions"
      },
      "gallery": {
        "type": "media",
        "multiple": true,
        "allowedTypes": [
          "images"
        ]
      }
